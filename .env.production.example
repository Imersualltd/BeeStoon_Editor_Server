# BeeStoon Editor Server - production settings (names only, no values).
# With NODE_ENV=production the server refuses to start when a required
# setting is missing or unsafe (src/auth/index.mjs productionProblems).

NODE_ENV=production
PORT=2567

# Identity: the editor token minted by the BeeStoon backend (POST /editor/token).
# JWT_SECRET is the SAME value as the backend's EDITOR_JWT_SECRET (32+ chars).
# It is NOT the site's SECRET_KEY.
AUTH_PROVIDER=jwt
JWT_SECRET=
JWT_ISSUER=beestoon-api
JWT_AUDIENCE=beestoon-editor
JWT_MAX_AGE_SECONDS=3600

# Browsers: the site origins that host the editor page
CORS_ORIGINS=https://beestoon.com,https://www.beestoon.com

# Credits: the BeeStoon account balance is the only ledger
CREDITS_PROVIDER=beestoon
# Paid editor features stay OFF until their prices are confirmed. Comma list of:
#   sessions (start a session), entry (join one), upgrade (change type), pool (credit pools)
# A feature that is off is refused, never free.
EDITOR_PAID_FEATURES=
BEESTOON_API_URL=
# Shared only between this server and the backend (32+ chars)
EDITOR_SERVICE_KEY=
# Editor access: the "Editor access" tick on the BeeStoon account (required in
# production). Connected people are rechecked every EDITOR_ACCESS_RECHECK_SECONDS.
EDITOR_ACCESS=beestoon
EDITOR_ACCESS_RECHECK_SECONDS=30
# Public anonymous AR share links (default off with EDITOR_ACCESS=beestoon)
AR_SHARING=off

# Invitations: links always open the site editor page
INVITE_BASE_URL=https://beestoon.com/editor
INVITE_TTL_HOURS=72
# resend (real emails) | log | capture (writes files to MAIL_CAPTURE_DIR, sends nothing)
MAIL_PROVIDER=
RESEND_API_KEY=
INVITE_FROM=

# This server's public address (model and AR links)
PUBLIC_BASE_URL=

# Storage: private bucket, short-lived signed links
SCENE_STORAGE=s3
AR_STORAGE=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SCENE_S3_PREFIX=scenes/
AR_LINK_HOURS=24
